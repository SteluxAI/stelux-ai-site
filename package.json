{
  "name": "stelux-ai-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build && node scripts/release-privacy.mjs dist",
    "privacy:test": "node --test scripts/release-privacy.test.mjs",
    "privacy:check": "node scripts/release-privacy.mjs dist",
    "preview": "vite preview --port 4173 --strictPort",
    "shots": "node scripts/screenshots.mjs",
    "deploy": "node scripts/release-privacy.mjs dist && wrangler pages deploy dist --project-name stelux-ai --branch main --commit-dirty=true"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0",
    "playwright": "^1.52.0",
    "wrangler": "^4.20.0"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.0"
  }
}
